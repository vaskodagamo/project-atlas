# ── OpenAI Realtime API (the brain) ─────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-realtime-2
# Voice for spoken replies (e.g. marin, cedar, alloy)
JARVIS_VOICE=marin

# ── Wake mechanism ──────────────────────────────────────────────────────────
# ptt       = push-to-talk: press Enter/space to start & stop a turn (no account, terminal only)
# porcupine = hands-free "Hey Jarvis" wake word (needs a Picovoice key below)
WAKE_MODE=ptt

# ── Picovoice Porcupine (only needed when WAKE_MODE=porcupine) ───────────────
# Free access key from https://console.picovoice.ai
PICOVOICE_ACCESS_KEY=
# 0.0 (fewer false triggers) .. 1.0 (more sensitive)
WAKE_SENSITIVITY=0.5

# ── OpenClaw backbone (memory + future tools) ───────────────────────────────
# The bridge shells out to the `openclaw agent` CLI, which drives the gateway daemon.
OPENCLAW_URL=http://127.0.0.1:18789
# Path to the openclaw binary. "openclaw" works when it's on PATH (e.g. running from Terminal).
# For the launchd service, set the absolute path from `which openclaw`.
OPENCLAW_BIN=openclaw
OPENCLAW_AGENT=main
# Reasoning effort for memory/tool answers: off|minimal|low|medium|high|... ("off" is fastest).
OPENCLAW_THINKING=off

# ── EMEET 360 audio device ──────────────────────────────────────────────────
# Capture: substring matched (case-insensitive) against input device names. Run `npm run list-devices`.
# Playback goes to the system DEFAULT output (ffplay), so also set the EMEET as your default
# output device in System Settings → Sound.
EMEET_DEVICE_NAME=EMEET
# Capture rate MUST equal Porcupine's rate (16000). ffmpeg resamples the device to this.
CAPTURE_SAMPLE_RATE=16000

# ── Email accounts (read + draft only, never sends) ─────────────────────────
# Account 1 — generic IMAP (e.g. work). Leave blank to skip. App password if 2FA is on.
IMAP_LABEL=work
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_TLS=true
# Drafts folder name (run `npm run test:email` to see exact names). Common: Drafts, INBOX.Drafts
IMAP_DRAFTS_FOLDER=Drafts
# From: line for drafts (defaults to IMAP_USER if blank)
EMAIL_FROM=

# Account 2 — Gmail (personal). Needs a Google APP PASSWORD (2-Step Verification must be ON):
#   myaccount.google.com → Security → App passwords. Host/port/Drafts are preset for Gmail.
GMAIL_LABEL=personal
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_DRAFTS_FOLDER=[Gmail]/Drafts

# ── Mac control ─────────────────────────────────────────────────────────────
# Lets Jarvis open apps, set volume, and (with spoken confirmation) run shell/AppleScript.
# Set to false to disable all Mac control tools.
MAC_CONTROL=true

# ── WhatsApp (UNOFFICIAL Baileys client — ToS violation, small ban risk) ────
# true = enable WhatsApp read + send (send is spoken-confirmation-gated). First run prints a QR to
# scan from your phone (WhatsApp → Linked Devices). Session persists in .whatsapp-auth/ (gitignored).
WHATSAPP_ENABLED=false

# ── WiZ smart light (local UDP, port 38899) ─────────────────────────────────
# Set the bulb's LAN IP to enable voice light control. Find it with `npm run wiz-discover`.
WIZ_LIGHT_IP=
WIZ_LIGHT_NAME=office light

# ── Blink doorbell (unofficial; proactive announcements) ────────────────────
# Auth the Python helper first (see blink/README.md), then set BLINK_ENABLED=true + the camera name.
BLINK_ENABLED=false
BLINK_CAMERA=
BLINK_POLL_SECONDS=20
# Defaults assume you run from the voice-bridge dir; absolute paths are safest for the launchd service.
BLINK_PYTHON=blink/.venv/bin/python
BLINK_HELPER=blink/blink_helper.py
BLINK_WATCHER=blink/blink_watcher.py
BLINK_VISION_MODEL=gpt-4o-mini
ANNOUNCE_TTS_MODEL=gpt-4o-mini-tts
# Optional: also push the doorbell snapshot + caption to this Telegram chat id (via the OpenClaw bot).
# Find your chat id by messaging @userinfobot on Telegram. Blank = don't send to Telegram.
BLINK_TELEGRAM_TARGET=
# What to send to Telegram on a ring: "video" (the recorded clip) or "photo" (a quick snapshot).
BLINK_MEDIA=video
# Where to save door snapshots/clips. Blank = OpenClaw workspace/jarvis-doorbell (must be an
# OpenClaw-allowed dir, or sends fail with "Local media path is not under an allowed directory").
BLINK_MEDIA_DIR=

# ── Behaviour ───────────────────────────────────────────────────────────────
# End the conversation after this many ms of inactivity (back to wake-word listening).
SESSION_INACTIVITY_MS=30000
LOG_LEVEL=info
